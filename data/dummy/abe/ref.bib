% data/dummy/abe/ref.bib — ABE の動作例の文献
%
% 内容は明らかなフィクション (TJD/THS のパロディ。出典は https://github.com/fk506cni/jami-pandoc-public)。
% ABE の文献の作法 (docs/journal-abe.md §4): 誌名は PubMed の略記で journal に持つ (架空誌なので PubMed には無い)・
% 全著者を書く (et al. で打ち切らない。chokkan2100 の 4 名がそれを見る)・題は省略しない。
% langid を付けない — ABE の規定には言語の注記 ("(in Japanese)" など) の作法が無く、abe.csl も言語の注記を出さない。
%
% 引用様式の受入テスト (規定の公式例 6 件との照合) は別のフィクスチャ data/dummy/abe-csl/ が持つ。

@article{yokan2099,
  author  = {Yokan, T. and Chokkan, H. and Dan, B.},
  title   = {A memorandum on the contents of last night's dream},
  journal = {Jpn J Tremendous Hunch},
  year    = {2099},
  volume  = {1},
  number  = {1},
  pages   = {1--8}
}

@article{chokkan2100,
